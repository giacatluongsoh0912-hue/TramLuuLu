{
  "entities": {
    "Memory": {
      "title": "Memory",
      "description": "A commemorative photo memory in the scrapbook",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 300 },
        "year": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "enum": ["classroom", "flower", "olympiad", "graduation"] },
        "caption": { "type": "string", "maxLength": 3000 },
        "author": { "type": "string", "maxLength": 200 },
        "imageSrc": { "type": "string", "maxLength": 500000 },
        "tags": { "type": "array" },
        "likes": { "type": "number" },
        "source": { "type": "string", "enum": ["manual", "facebook"] },
        "sourceUrl": { "type": "string", "maxLength": 500 },
        "externalId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["title", "category", "imageSrc"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Faculty profile of a teacher at THPT Chuyen Son La",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 300 },
        "department": { "type": "string", "maxLength": 100 },
        "departmentName": { "type": "string", "maxLength": 200 },
        "avatar": { "type": "string", "maxLength": 500000 },
        "quote": { "type": "string", "maxLength": 2000 },
        "achievements": { "type": "array" },
        "bio": { "type": "string", "maxLength": 5000 },
        "yearsOfService": { "type": "string", "maxLength": 100 },
        "likes": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "department", "departmentName"]
    },
    "Department": {
      "title": "Department",
      "description": "Academic department or subject group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "code": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 1000 },
        "teacherCount": { "type": "number" },
        "featuredQuote": { "type": "string", "maxLength": 2000 },
        "headTeacher": { "type": "string", "maxLength": 300 },
        "candleCount": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "teacherCount"]
    },
    "ContestMoment": {
      "title": "ContestMoment",
      "description": "A shared moment for Part 2 Thay Tro Chuyen Son La",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 300 },
        "cohort": { "type": "string", "maxLength": 150 },
        "caption": { "type": "string", "maxLength": 3000 },
        "imageSrc": { "type": "string", "maxLength": 500000 },
        "likes": { "type": "number" },
        "author": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "imageSrc"]
    },
    "Tribute": {
      "title": "Tribute",
      "description": "Gratitude letter or tribute note for teachers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderName": { "type": "string", "maxLength": 200 },
        "affiliation": { "type": "string", "maxLength": 300 },
        "recipient": { "type": "string", "maxLength": 300 },
        "department": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 6000 },
        "paperTheme": { "type": "string", "maxLength": 100 },
        "gift": { "type": "string", "maxLength": 100 },
        "likes": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["senderName", "content", "recipient"]
    },
    "PadletNote": {
      "title": "PadletNote",
      "description": "Sticky memory note on the Padlet board",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "author": { "type": "string", "maxLength": 200 },
        "className": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 2000 },
        "color": { "type": "string", "enum": ["yellow", "pink", "cyan", "purple", "orange"] },
        "tag": { "type": "string", "maxLength": 100 },
        "likes": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["author", "content", "color"]
    },
    "FlowerScore": {
      "title": "FlowerScore",
      "description": "Competition scores and flower counts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "flower9": { "type": "number" },
        "flower10": { "type": "number" },
        "participationRate": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["flower9", "flower10"]
    },
    "LeadershipMilestone": {
      "title": "LeadershipMilestone",
      "description": "Leadership timeline entry across 1995-2026 at THPT Chuyen Son La",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 300 },
        "roleType": { "type": "string", "enum": ["principal", "vice_principal"] },
        "period": { "type": "string", "maxLength": 150 },
        "milestoneTitle": { "type": "string", "maxLength": 300 },
        "contributions": { "type": "string", "maxLength": 4000 },
        "quote": { "type": "string", "maxLength": 2000 },
        "avatar": { "type": "string", "maxLength": 950000 },
        "order": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "title", "roleType"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Manifest for a chunked uploaded image stored in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mimeType": { "type": "string", "maxLength": 100 },
        "totalChunks": { "type": "number" },
        "totalBytes": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "totalChunks", "totalBytes"]
    },
    "MediaChunk": {
      "title": "MediaChunk",
      "description": "Chunk payload belonging to a MediaAsset",
      "type": "object",
      "properties": {
        "mediaId": { "type": "string", "maxLength": 128 },
        "index": { "type": "number" },
        "data": { "type": "string", "maxLength": 600000 }
      },
      "required": ["mediaId", "index", "data"]
    },
    "FilmFrame": {
      "title": "FilmFrame",
      "description": "Editable photo frame inside the cinematic film reel showcase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string", "maxLength": 200 },
        "alt": { "type": "string", "maxLength": 200 },
        "imageSrc": { "type": "string", "maxLength": 500000 },
        "objectPosition": { "type": "string", "maxLength": 60 },
        "order": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "label", "imageSrc", "order"]
    },
    "FacebookSyncState": {
      "title": "FacebookSyncState",
      "description": "Configuration and deduplication state for syncing school Facebook Fanpage posts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pageUrl": { "type": "string", "maxLength": 500 },
        "pageName": { "type": "string", "maxLength": 200 },
        "followerCount": { "type": "string", "maxLength": 50 },
        "autoSyncEnabled": { "type": "boolean" },
        "lastSyncAt": { "type": "number" },
        "syncedCount": { "type": "number" },
        "dismissedIds": { "type": "array" }
      },
      "required": ["id", "pageUrl", "autoSyncEnabled"]
    }
  },
  "firestore": {
    "/memories/{memoryId}": {
      "schema": "Memory",
      "description": "Public scrapbook memories viewable and editable by students and alumni"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Faculty profiles with accomplishments and photos"
    },
    "/leadership/{leadId}": {
      "schema": "LeadershipMilestone",
      "description": "School leadership timeline portraits and milestones"
    },
    "/departments/{departmentId}": {
      "schema": "Department",
      "description": "Faculty departments with teacher counts and candle counts"
    },
    "/contest_moments/{momentId}": {
      "schema": "ContestMoment",
      "description": "Teacher and student moments for the 20/11 contest"
    },
    "/tributes/{tributeId}": {
      "schema": "Tribute",
      "description": "Gratitude letters sent to teachers and departments"
    },
    "/padlet_notes/{noteId}": {
      "schema": "PadletNote",
      "description": "Padlet sticky notes"
    },
    "/competition_stats/{statId}": {
      "schema": "FlowerScore",
      "description": "Live 20/11 emulation flower scores"
    },
    "/media_assets/{mediaId}": {
      "schema": "MediaAsset",
      "description": "Metadata manifest for chunked high-capacity user photo uploads"
    },
    "/media_chunks/{chunkId}": {
      "schema": "MediaChunk",
      "description": "Data chunks for uploaded user photos"
    },
    "/film_frames/{frameId}": {
      "schema": "FilmFrame",
      "description": "Editable 4-frame showcase inside the cinematic film reel strip"
    },
    "/facebook_sync/{syncId}": {
      "schema": "FacebookSyncState",
      "description": "State and dismissed post tracking for automatic Facebook Fanpage memory sync"
    }
  }
}
